# ---------------- MCP server ----------------
PORT=3000
HOST=0.0.0.0
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_BEARER_TOKEN=

# ---------------- EDLCare identity ----------------
EDL_OIDC_DISCOVERY_URL=https://edlcare.edl.lk/.well-known/openid-configuration

# ---------------- EDLCare API ----------------
EDL_API_BASE_URL=https://edlcare.edl.lk

# Auth mode: bearer | client_credentials | none
EDL_AUTH_MODE=none
EDL_ACCESS_TOKEN=
EDL_CLIENT_ID=
EDL_CLIENT_SECRET=
EDL_SCOPE=cebcare-api-app
EDL_TOKEN_URL=https://edlcare.edl.lk/connect/token

EDL_PATH_ACCOUNTS=
EDL_PATH_BALANCE=
EDL_PATH_BILL_HISTORY=
EDL_PATH_USAGE=
EDL_PATH_OUTAGES=
EDL_PATH_PAYMENT_HISTORY=

EDL_ENABLE_RAW_GET=false

EDL_TIMEOUT_MS=15000
EDL_MAX_RESPONSE_BYTES=1048576
EDL_ALLOW_INSECURE_HTTP=false
